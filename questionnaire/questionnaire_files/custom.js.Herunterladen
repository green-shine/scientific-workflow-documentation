$(document).on("ready pjax:scriptcomplete", function () {
    /**
     * Code included inside this will only run once the page Document Object Model (DOM) is ready for JavaScript code to execute
     * @see https://learn.jquery.com/using-jquery-core/document-ready/
     */
});

document.addEventListener("DOMContentLoaded", () => {});
window.onload = function () {
    let headerElement = document.getElementById("survey-nav");
    let tableHeaderElements = document.querySelectorAll(
        ".ls-heading.ls-header .answer-text"
    );

    let headerHeight = headerElement.offsetHeight;

    if (tableHeaderElements.length === 0) {
        return;
    }

    tableHeaderElements.forEach((element) => {
        element.style.top = headerHeight + "px";
    });
};
